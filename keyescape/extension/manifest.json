{
  "manifest_version": 3,
  "name": "방탈출 예약 도우미",
  "version": "0.1.0",
  "description": "키이스케이프 서버 시간을 보여 주고, 예약이 열리는 시각에 한 번 새로고침하고, 내 정보를 버튼 한 번으로 채워 줍니다. 예약 버튼은 직접 누릅니다.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.keyescape.com/*", "https://keyescape.com/*", "https://www.keyescape.co.kr/*", "https://keyescape.co.kr/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
