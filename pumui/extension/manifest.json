{
  "manifest_version": 3,
  "name": "품의 기안 도우미",
  "version": "0.2.0",
  "description": "쇼핑몰 장바구니를 읽어 품의 기안 본문과 품목내역을 만들고, 에듀파인 칸에 바로 넣어 줍니다.",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://*.coupang.com/*",
    "https://*.gmarket.co.kr/*",
    "https://*.11st.co.kr/*",
    "https://*.i-screammall.co.kr/*",
    "https://*.go.kr/*",
    "http://*.go.kr/*"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "품의 기안 도우미 열기"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.go.kr/*",
        "http://*.go.kr/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}